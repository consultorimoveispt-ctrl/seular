# Copie para /home/user/vivaz/.env e preencha.
# NÃO commite este arquivo. O service_role key nunca deve ir para o navegador.
#
# Project Settings → API, no dashboard do Supabase
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...            # chave pública (anon)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # só no servidor / scripts de migração

# Storage
SUPABASE_BUCKET=vivaz-fotos

# Usuário inicial do app (criado no Supabase Auth)
VIVAZ_ADMIN_EMAIL=admin@vivaz.local
VIVAZ_ADMIN_PASSWORD=Vivaz@2026
