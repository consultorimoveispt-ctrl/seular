# Copie para .env e preencha. O .env real está no .gitignore (não versionar).
# A service_role key NUNCA deve ir para o navegador nem para o repositório.

# Supabase → Project Settings → API
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...            # chave pública (anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # somente no servidor

# Storage
SUPABASE_BUCKET=vivaz-fotos

# Usuário inicial (criado no Supabase Auth por docs/aplicar_supabase.py)
VIVAZ_ADMIN_EMAIL=admin@vivaz.local
VIVAZ_ADMIN_PASSWORD=troque-esta-senha

# Servidor
PORT=3000
VIVAZ_BACKEND=supabase                # ou sqlite para o backend local
